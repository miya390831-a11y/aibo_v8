# frontend: light | medium | heavy（仕様書 denoising）
INTENSITY_LEVELS = {
    "light": 0.15,
    "medium": 0.225,
    "heavy": 0.30,
}

NUM_INFERENCE_STEPS = 8
GUIDANCE_SCALE = 3.5


@dataclass
class MakeupResult:
    image: Optional[Image.Image]
    success: bool
    preset: str
    intensity: str
    denoising: float
    elapsed: float
    error: Optional[str] = None
    warnings: list[str] = field(default_factory=list)


def apply_makeup_with_pipeline_manager(
    pipeline_manager: Any,
    image: Image.Image,
    face_mask: Image.Image,
    makeup_style: str,
    intensity: str,
    seed: Optional[int] = None,
) -> MakeupResult:
    start = time.time()
    if makeup_style not in MAKEUP_PRESETS:
        return MakeupResult(
            None,
            False,
            makeup_style,
            intensity,
            0.0,
            0.0,
            error=f"unknown_makeup_type: {makeup_style}",
        )
    if intensity not in INTENSITY_LEVELS:
        return MakeupResult(
            None,
            False,
            makeup_style,
            intensity,
            0.0,
            0.0,
            error=f"unknown_intensity: {intensity}",
        )
    if image is None or face_mask is None:
        return MakeupResult(
            None,
            False,
            makeup_style,
            intensity,
            0.0,
            0.0,
            error="image_or_mask_none",
        )
    if image.size != face_mask.size:
        face_mask = face_mask.resize(image.size, Image.LANCZOS)

    denoising = INTENSITY_LEVELS[intensity]
    preset_data = MAKEUP_PRESETS[makeup_style]
    positive = preset_data["positive"]
    negative = preset_data["negative"]
    device = getattr(pipeline_manager, "device", "cuda")
    dev_str = str(device) if not isinstance(device, str) else device

    logger.info(
        "[MakeupEngine] 適用開始: preset=%s intensity=%s denoising=%.3f "
        "steps=%s guidance=%s negative=enabled",
        makeup_style,
        intensity,
        denoising,
        NUM_INFERENCE_STEPS,
        GUIDANCE_SCALE,
    )

    try:
        pipe_fill = pipeline_manager.ensure_fill_pipeline()
        if pipe_fill is None:
            return MakeupResult(
                None,
                False,
                makeup_style,
                intensity,
                denoising,
                time.time() - start,
                error="fill_pipeline_not_initialized",
            )

        if seed is not None:
            gen = torch.Generator(device=dev_str).manual_seed(int(seed))
        else:
            gen = torch.Generator(device=dev_str).manual_seed(
                int(torch.randint(0, 2**31 - 1, (1,)).item())
            )

        try:
            with torch.inference_mode():
                out = pipe_fill(
                    prompt=positive,
                    negative_prompt=negative,
                    image=image,
                    mask_image=face_mask,
                    strength=denoising,
                    guidance_scale=GUIDANCE_SCALE,
                    num_inference_steps=NUM_INFERENCE_STEPS,
                    generator=gen,
                )
            out_img = out.images[0] if hasattr(out, "images") else out[0]
            elapsed = time.time() - start
            logger.info("[MakeupEngine] 完了 %.2fs", elapsed)
            return MakeupResult(
                image=out_img,
                success=True,
                preset=makeup_style,
                intensity=intensity,
                denoising=denoising,
                elapsed=elapsed,
            )
        finally:
            pipeline_manager.restore_after_fill()

    except torch.cuda.OutOfMemoryError as oom:
        torch.cuda.empty_cache()
        logger.error("[MakeupEngine] OOM: %s", oom)
        try:
            pipeline_manager.restore_after_fill()
        except Exception:
            pass
        return MakeupResult(
            None,
            False,
            makeup_style,
            intensity,
            denoising,
            time.time() - start,
            error=f"oom: {oom}",
        )
    except Exception as exc:
        logger.exception("[MakeupEngine] 推論エラー: %s", exc)
        try:
            pipeline_manager.restore_after_fill()
        except Exception:
            pass
        return MakeupResult(
            None,
            False,
            makeup_style,
            intensity,
            denoising,
            time.time() - start,
            error=f"inference_error: {exc}",
        )


def list_makeup_presets() -> list[dict[str, str]]:
    return [{"key": k} for k in MAKEUP_PRESETS]
