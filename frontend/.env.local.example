# AIBO Studio v8.0 - Frontend Environment Variables
#
# コピー: cp .env.local.example .env.local （Windows: copy）

# Colab + ngrok 例
NEXT_PUBLIC_API_URL=https://YOUR-NGROK-URL.ngrok-free.dev

# ローカル FastAPI
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ngrok 警告ページスキップ（開発時）
NEXT_PUBLIC_NGROK_SKIP_WARNING=true
